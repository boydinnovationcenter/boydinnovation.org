// Cloudflare Workers config: serves the static Astro build (dist/).
// Cloudflare builds from main on every push (npm run build, then wrangler deploy).
// "name" must match the Worker's name in the Cloudflare dashboard.
{
	"$schema": "https://unpkg.com/wrangler@4/config-schema.json",
	"name": "boydinnovation",
	"compatibility_date": "2026-10-29",
	"assets": {
		"directory": "./dist",
		// Serves about.html at /about and redirects /about/ to /about, matching the live URLs.
		"html_handling": "auto-trailing-slash",
		// Unknown URLs get dist/404.html (src/pages/404.astro) with a 404 status.
		"not_found_handling": "404-page"
	}
}
