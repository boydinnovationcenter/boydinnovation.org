---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import CornerFlywheelHero from '../components/CornerFlywheelHero.astro';
import CtaButton from '../components/CtaButton.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import { site, tracking } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { inlineMarkdown } from '../lib/inline-markdown';

const entry = await getEntry('deepDive', 'deepDive');
if (!entry) throw new Error('Missing Deep Dive content: src/content/deep-dive-workshops.yaml');
const { seo, hero, intro, photos } = entry.data;

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
		{ '@type': 'ListItem', position: 2, name: hero.heading, item: `${site.url}/deep-dive-workshops` },
	],
};
---

<BaseLayout title={seo.title} description={seo.description} ogImage={seo.ogImage}>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	<CornerFlywheelHero heading={hero.heading} tagline={hero.tagline} taglineSize="large" flywheelWidth={325} height={668} />
	<section class="dd-intro" aria-labelledby="dd-intro-heading">
		<div class="container dd-intro__inner">
			<Image
				class="dd-intro__image"
				src={intro.image}
				alt={intro.alt}
				widths={[480, 720, 1100]}
				sizes="(min-width: 48rem) 38vw, 100vw"
			/>
			<div class="dd-intro__text">
				<h2 id="dd-intro-heading">{intro.heading}</h2>
				{intro.paragraphs.map((p) => <p set:html={inlineMarkdown(p)} />)}
				<CtaButton
					class="dd-intro__cta"
					variant="outline"
					label={intro.cta.label}
					hubspotCta={tracking.hubspotCtas[intro.cta.hubspotCta]}
					srContext={intro.cta.srContext}
				/>
			</div>
		</div>
	</section>
	<PhotoStrip photos={photos} />
</BaseLayout>

<style>
	/* Live at 1440: image 546 × 384 at the left, text column from x=726. */
	.dd-intro {
		padding-block: clamp(var(--space-6), 9.4vw, 8.4rem) clamp(var(--space-6), 6.7vw, 6rem);
		color: var(--color-text);
	}

	.dd-intro__inner {
		display: grid;
		gap: var(--space-5);
		align-items: center;
	}

	.dd-intro__image {
		width: 100%;
		aspect-ratio: 546 / 384;
		border-radius: 1.6rem;
		object-fit: cover;
	}

	.dd-intro__text p {
		margin-top: 1rem;
	}

	h2 + p {
		margin-top: 2rem;
	}

	/* Live on phones leaves a ~150px gap above the button; it follows the text here. */
	.dd-intro__text :global(.dd-intro__cta) {
		width: min(100%, 13.25rem);
		min-height: 4.25rem;
		margin-top: 1.25rem;
	}

	@media (max-width: 47.99rem) {
		.dd-intro__text :global(.dd-intro__cta) {
			width: 100%;
			min-height: 3.5rem;
		}
	}

	@media (min-width: 48rem) {
		.dd-intro__inner {
			grid-template-columns: minmax(0, 0.83fr) minmax(0, 1fr);
			gap: clamp(var(--space-5), 4.7vw, 4.2rem);
		}
	}
</style>
