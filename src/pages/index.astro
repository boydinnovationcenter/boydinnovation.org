---
import { getEntry } from 'astro:content';
import EventsFeature from '../components/home/EventsFeature.astro';
import Hero from '../components/home/Hero.astro';
import ProgramStages from '../components/home/ProgramStages.astro';
import SpaceOptions from '../components/home/SpaceOptions.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = await getEntry('home', 'home');
if (!entry) throw new Error('Missing homepage content: src/content/home.yaml');
const { seo, hero, explore, spaces, events, programs } = entry.data;
---

<BaseLayout title={seo.title} description={seo.description} ogImage={seo.ogImage}>
	<Hero headline={hero.headline} poster={hero.poster} explore={explore} />
	<SpaceOptions {...spaces} />
	<EventsFeature {...events} />
	<ProgramStages {...programs} />
</BaseLayout>
