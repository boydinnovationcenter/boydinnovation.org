---
import { getCollection, getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import CommunityAgenda from '../components/events/CommunityAgenda.astro';
import EventScripts from '../components/events/EventScripts.astro';
import EventsClosing from '../components/events/EventsClosing.astro';
import EventsHero from '../components/events/EventsHero.astro';
import SeriesSection from '../components/events/SeriesSection.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { eventStatus, toEasternIso } from '../lib/event-dates';

const entry = await getEntry('eventsPage', 'eventsPage');
if (!entry) throw new Error('Missing Events page content: src/content/events-page.yaml');
const { seo, hero, recurring, community, calendar, host, photos } = entry.data;

const events = (await getCollection('events')).map((e) => e.data);
const series = events.filter((e) => e.section === 'recurring');
const communityEvents = events.filter((e) => e.section === 'community');

const pageUrl = `${site.url}/events`;

// Event structured data for every dated session that hasn't happened yet:
// a series' next session and each upcoming community event.
const dated = [
	...series.flatMap((s) => (s.next ? [{ ...s, start: s.next.start, end: s.next.end, location: site.name }] : [])),
	...communityEvents,
].filter((e) => eventStatus(e.end ?? e.start) === 'upcoming');

const eventData = await Promise.all(
	dated.map(async (e) => {
		const image = await getImage({ src: e.image, width: 1200, format: 'jpeg' });
		const atBic = /boyd innovation center/i.test(e.location);
		const register = e.actions[0];
		return {
			'@type': 'Event',
			name: e.title,
			description: e.description,
			startDate: toEasternIso(e.start),
			...(e.end ? { endDate: toEasternIso(e.end) } : {}),
			eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
			eventStatus: 'https://schema.org/EventScheduled',
			image: new URL(image.src, site.url).href,
			location: atBic ? { '@id': `${site.url}/#place` } : { '@type': 'Place', name: e.location, address: e.location },
			...(atBic ? { organizer: { '@id': `${site.url}/#organization` } } : {}),
			...(register
				? { url: new URL('eventbrite' in register ? register.eventbrite.url : register.href, pageUrl).href }
				: {}),
		};
	}),
);

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
				{ '@type': 'ListItem', position: 2, name: 'Events', item: pageUrl },
			],
		},
		...eventData,
	],
};
---

<BaseLayout title={seo.title} description={seo.description} ogImage={seo.ogImage}>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	<EventsHero {...hero} />
	<SeriesSection {...recurring} series={series} />
	<CommunityAgenda {...community} events={communityEvents} />
	<EventsClosing calendar={calendar} host={host} />
	<PhotoStrip photos={photos} />
	<EventScripts />
</BaseLayout>
