---
/** The "link in bio" page for social media profiles. Content: src/content/links.yaml. */
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import SocialIcon from '../components/SocialIcon.astro';
import { socialLinks } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = await getEntry('links', 'links');
if (!entry) throw new Error('Missing Links content: src/content/links.yaml');
const { seo, logo, logoAlt, buttons } = entry.data;
---

<BaseLayout title={seo.title} description={seo.description} ogImage={seo.ogImage}>
	<section class="links" aria-labelledby="page-title">
		<!-- The live page has no heading; the logo is the page's h1 here. -->
		<h1 id="page-title">
			<Image class="links__logo" src={logo} alt={logoAlt} widths={[300, 600, 900]} sizes="13.4rem" loading="eager" />
		</h1>
		<ul class="links__social">
			{
				socialLinks.map((s) => (
					<li>
						<a href={s.href} target="_blank" rel="noopener">
							<SocialIcon network={s.network} />
							<span class="visually-hidden">
								{s.label} (opens in a new tab)
							</span>
						</a>
					</li>
				))
			}
		</ul>
		<ul class="links__buttons">
			{
				buttons.map((b) => {
					const external = b.href.startsWith('http');
					return (
						<li>
							<a href={b.href} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
								{b.label}
								{external && <span class="visually-hidden"> (opens in a new tab)</span>}
							</a>
						</li>
					);
				})
			}
		</ul>
	</section>
</BaseLayout>

<style>
	/* Live at 1440: a 1102px navy band; buttons 323 × 68, 11px apart. */
	.links {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: calc(var(--header-height) + clamp(0.75rem, 5.8vw, 5.3rem)) var(--gutter) clamp(var(--space-6), 5.4vw, 4.9rem);
		background: var(--color-navy-deep);
		color: var(--color-text-on-dark);
	}

	h1 {
		margin: 0;
	}

	/* The visible logo is 214px wide @1440 (Squarespace pads the image). */
	.links__logo {
		width: clamp(8rem, 14.9vw, 13.4rem);
	}

	.links__social {
		display: flex;
		gap: 0.25rem;
		margin-top: clamp(1.5rem, 3vw, 2.4rem);
		padding: 0;
		list-style: none;
	}

	.links__social a {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
	}

	.links__social a:hover {
		color: var(--color-accent);
	}

	.links__buttons {
		display: grid;
		gap: 0.7rem;
		width: min(100%, 20.2rem);
		margin-top: clamp(1rem, 3.4vw, 3rem);
		padding: 0;
		list-style: none;
	}

	@media (max-width: 47.99rem) {
		.links__buttons {
			width: 100%;
		}
	}

	.links__buttons a {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: clamp(3.5rem, 4.7vw, 4.25rem);
		padding: 0.5rem 1rem;
		border: 1px solid var(--color-accent);
		border-radius: 6.4px;
		color: var(--color-accent);
		font-size: var(--text-xs);
		letter-spacing: 0.02em;
		text-align: center;
		text-decoration: none;
		text-transform: uppercase;
		transition: background-color 0.2s ease;
	}

	.links__buttons a:hover {
		background: rgb(89 255 102 / 0.1);
	}
</style>
