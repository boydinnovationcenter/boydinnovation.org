---
/** One post in the blog list: thumbnail, date, title and "Read More". */
import { Image } from 'astro:assets';
import { postUrl, shortDate, type Post } from '../../lib/blog';

interface Props {
	post: Post;
	/** Load the image right away (first row of the list). */
	priority?: boolean;
	/** h3 when the cards sit under their own h2 (Related Posts). */
	headingLevel?: 2 | 3;
}

const { post, priority = false, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const href = postUrl(post);
---

<article class="post-card">
	<!-- The image repeats the title link, so it's skipped by keyboard and screen readers. -->
	<a class="post-card__image" href={href} tabindex="-1" aria-hidden="true">
		<Image
			src={post.data.image}
			alt=""
			widths={[400, 600, 900, 1200]}
			sizes="(min-width: 48rem) min(43vw, 591px), 100vw"
			loading={priority ? 'eager' : 'lazy'}
		/>
	</a>
	<time datetime={post.data.date.toISOString()}>{shortDate(post.data.date)}</time>
	<Heading class="post-card__title"><a href={href}>{post.data.title}</a></Heading>
	<a class="post-card__more" href={href}>Read More<span class="visually-hidden">: {post.data.title}</span></a>
</article>

<style>
	.post-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	/* Live: 591 × 394 (3:2), cropped to fill. */
	.post-card__image {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 2;
		overflow: hidden;
	}

	.post-card__image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	time {
		margin-top: 1.25rem;
		font-size: var(--text-xs);
		line-height: 1.3;
	}

	.post-card__title {
		margin-top: 1.1rem;
		font-size: var(--text-h3);
		font-weight: 500;
		line-height: 1.3;
	}

	.post-card__title a {
		text-decoration: none;
	}

	.post-card__title a:hover {
		text-decoration: underline;
	}

	.post-card__more {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		margin-top: 1.2rem;
		font-size: var(--text-xs);
		color: var(--color-accent);
	}
</style>
