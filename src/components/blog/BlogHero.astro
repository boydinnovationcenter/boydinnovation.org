---
/**
 * Blog list hero: full-bleed photo under a navy wash, the flywheel mark top
 * right, a green eyebrow and a three-line headline at the bottom left.
 */
import { Image } from 'astro:assets';
import flywheel from '../../assets/images/brand/flywheel.png';

interface Props {
	eyebrow: string;
	headline: string[];
	image: ImageMetadata;
}

const { eyebrow, headline, image } = Astro.props;
// Size the headline so its longest word never breaks mid-word on phones.
const longestWord = Math.max(...headline.join(' ').split(/\s+/).map((w) => w.length));
---

<section class="blog-hero" aria-labelledby="page-title" style={`--longest-word: ${longestWord}`}>
	<Image
		class="blog-hero__bg"
		src={image}
		alt=""
		widths={[640, 1024, 1440, 1600]}
		sizes="100vw"
		loading="eager"
		fetchpriority="high"
	/>
	<Image class="blog-hero__flywheel" src={flywheel} alt="" width={100} densities={[1, 2, 3]} loading="eager" />
	<div class="blog-hero__content">
		<p class="blog-hero__eyebrow">{eyebrow}</p>
		<h1 id="page-title">
			{headline.map((line, i) => (i === 0 ? line : [<br />, line]))}
		</h1>
	</div>
</section>

<style>
	/* Live at 1440: 751px tall including the header; headline ends 81px above the bottom. */
	.blog-hero {
		position: relative;
		isolation: isolate;
		display: flex;
		align-items: flex-end;
		min-height: clamp(30rem, 52vw, 47rem);
		padding: calc(var(--header-height) + 6rem) var(--gutter) clamp(var(--space-6), 5.6vw, 5rem);
		overflow: hidden;
		color: var(--color-text-on-dark);
	}

	.blog-hero__bg {
		position: absolute;
		inset: 0;
		z-index: -2;
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* Squarespace focal point for this photo (46% across, 4% down). */
		object-position: 46% 4%;
	}

	/* Navy wash at 70%, as on the other photo heroes. */
	.blog-hero::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: rgb(4 30 52 / 0.7);
	}

	.blog-hero__flywheel {
		position: absolute;
		top: calc(var(--header-height) + 2.75rem);
		right: var(--gutter);
		width: clamp(3.5rem, 7vw, 6.25rem);
	}

	.blog-hero__content {
		width: 100%;
		container-type: inline-size;
	}

	.blog-hero__eyebrow {
		font-size: clamp(1.27rem, 1.2rem + 0.33vw, 1.41rem);
		font-weight: 700;
		color: var(--color-accent);
		text-transform: uppercase;
	}

	/* 81px @1440 like the other heroes; on phones as large as live (about
	   50px) but capped so the longest word fits on one line (live breaks
	   "Highlightin-g" at 390px). About 0.62em per bold character. */
	h1 {
		font-size: min(var(--text-hero), 100cqi / (var(--longest-word) * 0.62));
		font-weight: 700;
		line-height: 1.09;
	}
</style>
