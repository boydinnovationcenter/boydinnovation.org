---
/**
 * "Past Tech on Tap Events": heading and optional button in a left column
 * (sticky on desktop). On the right, the recap video large at the top (plays
 * when clicked, with captions), then every session newest first, two across
 * and split by a hairline. Each card shows the speaker with
 * their company and the month; a panel shows its title, then the panelists'
 * names. (Single speakers' talk titles are kept in the content but not shown.) Cards aren't links and have
 * no hover effect. Sessions without a photo get a branded placeholder.
 * One column on phones; the left column moves above from 64rem down.
 */
import { getImage, Image } from 'astro:assets';
import CtaButton from '../CtaButton.astro';

interface Session {
	date: string;
	speakers: { name: string; company?: string }[];
	talk?: string;
	image?: ImageMetadata;
	imageAlt?: string;
}

interface Props {
	heading: string;
	cta?: { label: string; href: string };
	/** Recap video, large above the sessions: plays only when clicked, with captions. */
	video?: { src: string; captions?: string; poster: ImageMetadata; label: string };
	events: Session[];
}

const { heading, cta, video, events } = Astro.props;
// Sharp at the ~830px-wide top spot (and on phones).
const videoPoster = video ? await getImage({ src: video.poster, width: 1400, format: 'webp' }) : undefined;
const sessions = [...events].sort((a, b) => b.date.localeCompare(a.date));
/** Panels show the title where a speaker's name would be, with the names (comma-separated) below. */
const isPanel = (s: Session) => s.speakers.length > 1;

const monthYear = (date: string) =>
	new Date(`${date}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const fullDate = (date: string) =>
	new Date(`${date}T12:00:00Z`).toLocaleDateString('en-US', {
		month: 'long',
		day: 'numeric',
		year: 'numeric',
		timeZone: 'UTC',
	});
---

{
	(sessions.length > 0 || video) && (
		<section class="past" aria-labelledby="past-heading">
			<div class="container past__inner">
				<div class="past__intro">
					<h2 id="past-heading">{heading}</h2>
					{cta && <CtaButton class="past__cta" variant="primary" label={cta.label} href={cta.href} />}
				</div>

				<div class="past__main">
					{video && (
						<div class="past__feature">
							<video
								class="past__video"
								controls
								playsinline
								preload="none"
								poster={videoPoster!.src}
								width="1920"
								height="1080"
								aria-label={video.label}
							>
								<source src={video.src} type="video/mp4" />
								{video.captions && <track kind="captions" src={video.captions} srclang="en" label="English" />}
							</video>
						</div>
					)}
				<ul class="past__list" role="list">
					{sessions.map((s) => (
						<li class="session">
							<div class="session__media">
								{s.image ? (
									<Image
										src={s.image}
										alt={s.imageAlt ?? ''}
										widths={[400, 640, 900]}
										sizes="(min-width: 64rem) 25rem, (min-width: 36rem) 50vw, 100vw"
									/>
								) : (
									<div class="session__placeholder" aria-hidden="true">
										<span>Tech on Tap</span>
									</div>
								)}
							</div>
							<div class="session__meta">
								{isPanel(s) && s.talk ? (
									<h3 class="session__speakers">
										{/* Separators sit inside the name span so screen readers hear "Title, with names" (no stray space before the comma). */}
										<span class="session__name">
											{s.talk}
											<span class="visually-hidden">{', with '}</span>
										</span>
										<span class="session__company">{s.speakers.map((p) => p.name).join(', ')}</span>
									</h3>
								) : (
									<h3 class="session__speakers">
										{s.speakers.map((p, j) => (
											<span class="session__speaker">
												<span class="session__name">
													{p.name}
													{p.company && <span class="visually-hidden">{', '}</span>}
												</span>
												{p.company && <span class="session__company">{p.company}</span>}
												{j < s.speakers.length - 1 && <span class="visually-hidden">{'; '}</span>}
											</span>
										))}
									</h3>
								)}
								<time class="session__date" datetime={s.date} title={fullDate(s.date)}>
									{monthYear(s.date)}
								</time>
							</div>
						</li>
					))}
				</ul>
				</div>
			</div>
		</section>
	)
}

<style>
	.past {
		padding-block: clamp(3rem, 6vw, 5.45rem);
		color: var(--color-text);
	}

	.past__inner {
		display: grid;
		gap: var(--space-5);
		padding-top: var(--space-5);
		border-top: var(--border);
	}

	.past__intro {
		display: grid;
		align-content: start;
		justify-items: start;
		gap: var(--space-4);
	}

	/* The recap video in the top spot, above the two-across sessions. */
	.past__feature {
		margin-bottom: var(--space-5);
		padding-bottom: var(--space-5);
		border-bottom: var(--border);
	}

	.past__video {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover; /* the poster photo is 3:2 */
		border-radius: 10px;
		background: var(--color-black);
	}

	h2 {
		font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
		font-weight: 500;
		line-height: 1.05;
	}

	/* Sessions: one column on phones, two from small tablets. */
	.past__list {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-5) 0;
		margin: 0;
		padding: 0;
	}

	.session {
		position: relative;
		display: grid;
		align-content: start;
		gap: 0.6rem;
	}

	.session__media {
		overflow: hidden;
		border-radius: 10px;
		aspect-ratio: 3 / 2;
	}

	.session__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.session__placeholder {
		display: grid;
		place-items: end start;
		height: 100%;
		padding: var(--space-3);
		background:
			radial-gradient(120% 90% at 85% 10%, rgb(0 153 255 / 0.45), transparent 60%),
			linear-gradient(160deg, var(--color-navy) 0%, var(--color-navy-deep) 55%, var(--color-black) 100%);
		color: var(--color-green);
		font-family: var(--font-display);
		font-size: var(--text-xs);
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.session__meta {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-3);
	}

	.session__speakers {
		display: grid;
		gap: 0.5rem;
		font-size: var(--text-h3);
		font-weight: 500;
		line-height: var(--leading-tight);
	}

	.session__speaker,
	.session__name,
	.session__company {
		display: block;
	}

	.session__company {
		margin-top: 0.15rem;
		font-size: var(--text-sm);
		font-weight: 400;
	}

	.session__date {
		flex: none;
		padding-top: 0.3em;
		font-family: var(--font-display);
		font-size: var(--text-xs);
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	@media (min-width: 36rem) {
		.past__list {
			grid-template-columns: 1fr 1fr;
		}

		/* Hairline between the two columns, as in the grid's left/right split. */
		.session:nth-child(odd) {
			padding-right: var(--space-4);
		}

		.session:nth-child(even) {
			padding-left: var(--space-4);
			border-left: var(--border);
		}

	}

	@media (min-width: 64rem) {
		.past__inner {
			grid-template-columns: minmax(14rem, 1fr) 2.6fr;
			gap: 0;
		}

		.past__intro {
			position: sticky;
			top: calc(var(--header-height) + var(--space-4));
			padding-right: var(--space-5);
		}

		.past__main {
			padding-left: var(--space-5);
			border-left: var(--border);
		}
	}
</style>
