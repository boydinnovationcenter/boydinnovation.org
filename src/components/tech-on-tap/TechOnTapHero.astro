---
/**
 * Tech on Tap hero: the page title over a muted background loop of event
 * footage (as on the homepage). The poster shows first; the video plays only
 * without prefers-reduced-motion or Save-Data, and a button pauses it
 * (WCAG 2.2.2).
 */
import { Image } from 'astro:assets';

interface Props {
	heading: string;
	background: { poster: ImageMetadata; small: string; large: string };
}

const { heading, background } = Astro.props;
---

<section class="tot-hero" aria-labelledby="page-title">
	<div class="tot-hero__bg" aria-hidden="true">
		<Image
			class="tot-hero__bg-poster"
			src={background.poster}
			alt=""
			widths={[640, 960, 1440, 1920]}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
		/>
		<video class="tot-hero__bg-video" muted loop playsinline preload="none" disablepictureinpicture>
			<source src={background.small} type="video/mp4" media="(max-width: 767px)" />
			<source src={background.large} type="video/mp4" />
		</video>
	</div>

	<h1 id="page-title">{heading}</h1>

	<button class="tot-hero__pause" type="button" aria-pressed="false" hidden>
		<span class="visually-hidden">Pause background video</span>
		<svg class="tot-hero__pause-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
			<rect x="6" y="5" width="4" height="14" rx="1" fill="currentColor"></rect>
			<rect x="14" y="5" width="4" height="14" rx="1" fill="currentColor"></rect>
		</svg>
		<svg class="tot-hero__play-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
			<path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z" fill="currentColor"></path>
		</svg>
	</button>
</section>

<script>
	// Play the background loop only when motion is welcome and the visitor isn't saving data.
	const video = document.querySelector<HTMLVideoElement>('.tot-hero__bg-video');
	const button = document.querySelector<HTMLButtonElement>('.tot-hero__pause');
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

	if (video && button && !reduceMotion && !saveData) {
		const label = button.querySelector('.visually-hidden')!;
		video.addEventListener(
			'playing',
			() => {
				video.classList.add('is-playing');
				button.hidden = false;
			},
			{ once: true },
		);
		button.addEventListener('click', () => {
			const pause = !video.paused;
			if (pause) video.pause();
			else video.play().catch(() => {});
			button.setAttribute('aria-pressed', String(pause));
			label.textContent = pause ? 'Play background video' : 'Pause background video';
		});
		video.play().catch(() => {});
	}
</script>

<style>
	.tot-hero {
		position: relative;
		isolation: isolate;
		display: grid;
		place-items: center;
		min-height: clamp(24rem, 48vw, 40rem);
		padding: calc(var(--header-height) + var(--space-5)) var(--gutter) var(--space-7);
		overflow: hidden;
		background: var(--color-navy-deep);
		color: #fff;
		text-align: center;
	}

	.tot-hero__bg {
		position: absolute;
		inset: 0;
		z-index: -1;
	}

	/* Navy wash so the title stays readable over the footage. */
	.tot-hero__bg::after {
		content: '';
		position: absolute;
		inset: 0;
		background: rgb(4 30 51 / 0.62);
	}

	.tot-hero__bg :global(.tot-hero__bg-poster),
	.tot-hero__bg-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.tot-hero__bg-video {
		opacity: 0;
		transition: opacity 0.6s ease;
	}

	.tot-hero__bg-video.is-playing {
		opacity: 1;
	}

	h1 {
		font-size: clamp(3rem, 1.6rem + 6vw, 6.5rem);
		line-height: 1;
		text-shadow: 0 2px 24px rgb(0 3 31 / 0.35);
	}

	.tot-hero__pause {
		position: absolute;
		right: var(--gutter);
		bottom: var(--space-4);
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 1px solid rgb(236 246 242 / 0.6);
		border-radius: 50%;
		background: rgb(0 3 31 / 0.55);
		color: var(--color-text-on-dark);
		cursor: pointer;
	}

	.tot-hero__pause[hidden] {
		display: none;
	}

	.tot-hero__pause:hover {
		background: rgb(0 3 31 / 0.8);
	}

	.tot-hero__play-icon,
	.tot-hero__pause[aria-pressed='true'] .tot-hero__pause-icon {
		display: none;
	}

	.tot-hero__pause[aria-pressed='true'] .tot-hero__play-icon {
		display: block;
	}
</style>
