---
/**
 * "Recent Event" recap: heading, thank-you line and the panel speakers.
 * Each speaker's photo links to their LinkedIn, the logo to their company.
 * Three across from small tablets up; on phones each speaker is a row of
 * photo and card.
 */
import { Image } from 'astro:assets';

interface Props {
	heading: [string, string];
	thanks: string;
	speakers: {
		name: string;
		role: string;
		photo: ImageMetadata;
		linkedin: string;
		company: string;
		logo: ImageMetadata;
		companyUrl: string;
	}[];
}

const { heading, thanks, speakers } = Astro.props;
---

<section class="recent" aria-labelledby="recent-heading">
	<div class="container">
		<h2 class="recent__heading" id="recent-heading">
			<span class="recent__line1">{heading[0]}</span>{' '}
			<span class="recent__line2">{heading[1]}</span>
		</h2>
		<p class="recent__thanks"><span>{thanks}</span></p>

		<ul class="speakers" role="list">
			{
				speakers.map((s) => (
					<li class="speaker">
						<a class="speaker__photo" href={s.linkedin} target="_blank" rel="noopener">
							<Image src={s.photo} alt={`${s.name} on LinkedIn`} width={212} densities={[1, 2]} />
							<span class="visually-hidden"> (opens in a new tab)</span>
						</a>
						<div class="speaker__card">
							<h3>{s.name}</h3>
							<p>{s.role}</p>
							<a class="speaker__logo" href={s.companyUrl} target="_blank" rel="noopener">
								<Image src={s.logo} alt={`${s.company} website`} width={134} densities={[1, 2]} />
								<span class="visually-hidden"> (opens in a new tab)</span>
							</a>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.recent {
		padding-block: clamp(3rem, 6vw, 5.45rem);
		color: var(--color-text);
		text-align: center;
	}

	/* Squarespace "scaled text": each line is sized to fill its column, so
	   font sizes are set relative to the column width. */
	.recent__heading,
	.recent__thanks {
		container-type: inline-size;
		margin-inline: auto;
	}

	.recent__heading {
		width: min(100%, 55rem);
		font-weight: 700;
		line-height: 1;
	}

	.recent__heading span {
		display: block;
	}

	.recent__line1 {
		font-size: 5.95cqi;
	}

	.recent__line2 {
		margin-top: 0.12em;
		font-size: 9cqi;
	}

	.recent__thanks {
		width: min(100%, 41rem);
		margin-top: 0.9rem;
		font-weight: 700;
		line-height: 1.25;
		color: var(--color-blue);
	}

	.recent__thanks span {
		font-size: 6.2cqi;
	}

	.speakers {
		display: grid;
		gap: 0.65rem;
		width: min(100%, 41rem);
		margin: clamp(2rem, 5vw, 4.4rem) auto 0;
		padding: 0;
		list-style: none;
	}

	.speaker {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.65rem;
	}

	.speaker__photo img {
		width: 100%;
		height: 100%;
		aspect-ratio: 212 / 226;
		object-fit: cover;
		border-radius: 10px;
	}

	.speaker__card {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.15rem;
		padding: 0.75rem 0.5rem;
		border: 1px solid var(--color-black);
		border-radius: 10px;
	}

	h3 {
		font-size: 1rem;
		font-weight: 700;
		line-height: 1.5;
	}

	.speaker__card p {
		line-height: 1.6;
	}

	.speaker__logo {
		display: block;
		margin-top: 0.4rem;
	}

	.speaker__logo img {
		width: auto;
		max-width: min(100%, 8.4rem);
		max-height: 2.9rem;
	}

	@media (min-width: 36rem) {
		.speakers {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.speaker {
			grid-template-columns: 1fr;
			grid-template-rows: auto 1fr;
		}

		.speaker__card {
			min-height: 9.2rem;
		}
	}
</style>
