---
import { Image } from 'astro:assets';
import flywheel from '../../assets/images/brand/flywheel-navy.png';
import { tracking } from '../../config/site';
import CtaButton from '../CtaButton.astro';

interface Props {
	heading: string;
	cta: { label: string; href?: string; hubspotCta?: keyof typeof tracking.hubspotCtas };
}

const { heading, cta } = Astro.props;
---

<section class="closing">
	<Image src={flywheel} alt="" width={68} densities={[1, 2, 3]} />
	<h3>{heading}</h3>
	<CtaButton
		class="closing__cta"
		variant="texture"
		label={cta.label}
		href={cta.href}
		hubspotCta={cta.hubspotCta && tracking.hubspotCtas[cta.hubspotCta]}
	/>
</section>

<style>
	.closing {
		display: grid;
		justify-items: center;
		gap: var(--space-4);
		padding: 4.9rem var(--gutter) var(--space-6);
		text-align: center;
	}

	.closing img {
		width: 4.25rem;
	}

	h3 {
		font-weight: 700;
	}

	.closing :global(.closing__cta) {
		width: min(100%, 13.25rem);
		min-height: 4.25rem;
		margin-top: var(--space-3);
	}
</style>
