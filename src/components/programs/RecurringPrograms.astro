---
interface Props {
	eyebrow: string;
	heading: string;
	items: { title: string; description: string }[];
}

const { eyebrow, heading, items } = Astro.props;
---

<section class="recurring" aria-labelledby="recurring-heading">
	<div class="container">
		<p class="recurring__eyebrow">{eyebrow}</p>
		<h2 id="recurring-heading">{heading}</h2>
		<ul class="recurring__list" role="list">
			{
				items.map((item) => (
					<li class="recurring__item">
						<h3>{item.title}</h3>
						<p>{item.description}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.recurring {
		padding-block: var(--space-7);
		background: var(--color-navy-deep);
		color: var(--color-text-on-dark);
	}

	.recurring__eyebrow {
		font-size: clamp(1.1rem, 1rem + 0.4vw, 1.4rem);
		font-weight: 700;
		line-height: 1.4;
		color: var(--color-accent);
	}

	.recurring__list {
		display: grid;
		gap: var(--space-5);
		margin-top: var(--space-6);
		padding: 0;
		list-style: none;
	}

	.recurring__item {
		display: grid;
		align-content: start;
		gap: var(--space-4);
		padding: var(--space-5) clamp(1.25rem, 4vw, 3.5rem);
		border: 1px solid var(--color-paper);
		border-radius: var(--radius);
		text-align: center;
	}

	.recurring__item p {
		font-weight: 700;
	}

	@media (min-width: 48rem) {
		.recurring {
			padding-block: 5.9rem;
		}

		.recurring__list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: clamp(2rem, 8.5vw, 7.6rem);
		}

		.recurring__item {
			min-height: 25.4rem;
			padding-block: 2.5rem;
		}
	}
</style>
