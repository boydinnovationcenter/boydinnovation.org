---
/**
 * Homepage hero: looping background video, the headline, and the
 * "What are you looking for?" panel that overlaps the bottom of the hero.
 *
 * The overlap was built on Squarespace with `translate: 0 500px` on each block.
 * Here the panel sits in normal flow and is pulled up with a negative margin,
 * so it never causes overflow and the next section doesn't need a spacer.
 */
import { Image } from 'astro:assets';
import flywheel from '../../assets/images/brand/flywheel.png';

interface Props {
	headline: string[];
	poster: ImageMetadata;
	explore: {
		heading: string;
		cards: { title: string; href: string; image: ImageMetadata; alt: string }[];
	};
}

const { headline, poster, explore } = Astro.props;

// "COLUM[BI]A" -> [{ text: 'COLUM' }, { text: 'BI', accent: true }, { text: 'A' }]
const parseLine = (line: string) =>
	line
		.split(/(\[[^\]]+\])/)
		.filter(Boolean)
		.map((part) => (part.startsWith('[') ? { text: part.slice(1, -1), accent: true } : { text: part, accent: false }));

// Accessible name without the indentation used for the visual layout.
const headlineLabel = headline.map((line) => line.replace(/[[\]]/g, '').trim()).join(' ');
---

<section class="hero">
	<div class="hero__media" aria-hidden="true">
		<Image
			class="hero__poster"
			src={poster}
			alt=""
			widths={[640, 960, 1440, 1920]}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
		/>
		<video class="hero__video" muted loop playsinline preload="none" disablepictureinpicture>
			<source src="/video/hero-720.mp4" type="video/mp4" media="(max-width: 767px)" />
			<source src="/video/hero-1080.mp4" type="video/mp4" />
		</video>
	</div>

	<h1 class="hero__title" aria-label={headlineLabel}>
		<Image class="hero__flywheel" src={flywheel} alt="" width={160} loading="eager" />
		{
			headline.map((line) => (
				<span class="hero__line">
					{parseLine(line).map((part) => (part.accent ? <span class="hero__accent">{part.text}</span> : part.text))}
				</span>
			))
		}
	</h1>
</section>

<section class="explore" aria-labelledby="explore-heading">
	<div class="container">
		<h2 id="explore-heading">{explore.heading}</h2>
		<ul class="explore__panel" role="list">
			{
				explore.cards.map((card) => (
					<li class="explore-card">
						<h3>
							<a href={card.href}>{card.title}</a>
						</h3>
						<Image src={card.image} alt={card.alt} widths={[280, 400, 560]} sizes="(min-width: 768px) 17rem, 11rem" />
					</li>
				))
			}
		</ul>
	</div>
</section>

<script>
	// Play the background video only when motion is welcome and the visitor isn't saving data.
	const video = document.querySelector<HTMLVideoElement>('.hero__video');
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

	if (video && !reduceMotion && !saveData) {
		video.addEventListener('playing', () => video.classList.add('is-playing'), { once: true });
		video.play().catch(() => {});
	}
</script>

<style>
	.hero,
	.explore {
		/* Height of the explore heading row, and how far the panel overlaps the video. */
		--explore-head: calc(var(--text-h2) * 1.25 + 1rem);
		--overlap: 29rem;
		--title-top: 16.6rem;
		--title-gap: 6.25rem;
	}

	.hero {
		position: relative;
		isolation: isolate;
		padding: var(--title-top) var(--gutter) calc(var(--title-gap) + var(--explore-head) + var(--overlap));
		background: var(--color-black);
		color: var(--color-text-on-dark);
		overflow: hidden;
	}

	.hero__media {
		position: absolute;
		inset: 0;
		z-index: -1;
	}

	/* Live site shows the video at 65% opacity over the navy background. */
	.hero__media::after {
		content: '';
		position: absolute;
		inset: 0;
		background: rgb(0 3 31 / 0.35);
	}

	.hero__poster,
	.hero__video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero__video {
		opacity: 0;
		transition: opacity 0.6s ease;
	}

	.hero__video.is-playing {
		opacity: 1;
	}

	.hero__title {
		position: relative;
		width: fit-content;
		margin-inline: auto;
		font-family: var(--font-display);
		font-size: var(--text-hero);
		font-weight: 400;
		line-height: 1;
		white-space: pre;
	}

	.hero__line {
		display: block;
	}

	.hero__accent {
		color: var(--color-accent);
	}

	.hero__flywheel {
		position: absolute;
		top: -0.8em;
		right: 0;
		width: 1.22em;
	}

	.explore {
		position: relative;
		z-index: 1;
		margin-top: calc(-1 * (var(--explore-head) + var(--overlap)));
		padding-bottom: var(--space-6);
	}

	.explore h2 {
		margin-bottom: 1rem;
		color: var(--color-text-on-dark);
	}

	.explore__panel {
		display: grid;
		gap: var(--space-5);
		justify-items: center;
		padding: var(--space-5) clamp(1.5rem, 8vw, 2.7rem) var(--space-6);
		list-style: none;
		background: var(--color-paper);
		border-radius: var(--radius);
		box-shadow: 0 10px 30px -10px rgb(0 3 31 / 0.25);
	}

	.explore-card {
		position: relative;
		display: flex;
		flex-direction: column-reverse;
		align-items: center;
		gap: var(--space-2);
		width: min(100%, 16rem);
		padding: var(--space-4) var(--space-3) var(--space-3);
		border: var(--border);
		border-radius: var(--radius);
	}

	.explore-card h3 {
		color: var(--color-text);
	}

	/* The whole card is clickable; the link text is the card title. */
	.explore-card a {
		text-decoration: none;
	}

	.explore-card a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.explore-card a:focus-visible {
		outline: none;
	}

	.explore-card:has(a:focus-visible) {
		outline: 3px solid var(--color-blue);
		outline-offset: 3px;
	}

	.explore-card img {
		width: 67%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: 4px;
		transition: opacity 0.2s ease;
	}

	.explore-card:hover img {
		opacity: 0.75;
	}

	@media (min-width: 48rem) {
		.hero,
		.explore {
			--overlap: 6.6rem;
			--title-top: 14.4rem;
			--title-gap: 2.4rem;
		}

		.explore {
			padding-bottom: var(--space-6);
		}

		.explore__panel {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: clamp(1rem, 3.8vw, 3.45rem);
			padding: 3.55rem clamp(1.5rem, 3.8vw, 3.45rem) 5.75rem;
		}

		.explore-card {
			flex-direction: column;
			gap: var(--space-3);
			width: 100%;
			max-width: 20.7rem;
			padding: 0.9rem 0 1.8rem;
		}

		.explore-card img {
			width: 80%;
		}
	}
</style>
