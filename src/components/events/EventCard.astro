---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	event: CollectionEntry<'events'>['data'];
	/** "past" dims the card (it ended within the last 48 hours). */
	status: 'upcoming' | 'past';
}

const { event, status } = Astro.props;
const endsAt = event.end ?? event.start;
const isExternal = (href: string) => href.startsWith('http');
---

<li class:list={['event-card', { 'event-card--past': status === 'past' }]} data-ends={endsAt}>
	<Image
		class="event-card__img"
		src={event.image}
		alt={event.imageAlt}
		widths={[400, 640, 900]}
		sizes="(min-width: 64rem) 30rem, (min-width: 48rem) 45vw, 100vw"
	/>
	<div class="event-card__body">
		{
			event.start ? (
				<time class="event-card__date" datetime={event.start}>
					{event.dateLabel}
				</time>
			) : (
				<p class="event-card__date">{event.dateLabel}</p>
			)
		}
		<h3 class="event-card__title">{event.title}</h3>
		<p class="event-card__meta">{event.location}</p>
		<p class="event-card__desc">{event.description}</p>
		{
			event.actions.length > 0 && (
				<div class="event-card__actions">
					{event.actions.map((action) =>
						'eventbrite' in action ? (
							<a
								class="event-card__cta"
								href={action.eventbrite.url}
								target="_blank"
								rel="noopener"
								data-eventbrite-id={action.eventbrite.id}
							>
								{action.label}
								<span class="visually-hidden"> for {event.title}</span>
							</a>
						) : (
							<a
								class="event-card__cta"
								href={action.href}
								{...(isExternal(action.href) ? { target: '_blank', rel: 'noopener' } : {})}
							>
								{action.label}
								<span class="visually-hidden">
									{' '}
									for {event.title}
									{isExternal(action.href) && ' (opens in a new tab)'}
								</span>
							</a>
						),
					)}
				</div>
			)
		}
	</div>
</li>

<style>
	/* Card styles carried over from the live site's custom CSS (.bic-event). */
	.event-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border: 1px solid rgb(255 255 255 / 0.1);
		border-radius: var(--radius);
		background: var(--color-mint);
		box-shadow: 0 14px 34px -14px rgb(4 30 51 / 0.45);
		transition: opacity 0.25s ease;
	}

	.event-card--past {
		opacity: 0.4;
		filter: brightness(0.75);
	}

	.event-card--past:hover {
		opacity: 0.6;
	}

	.event-card--past .event-card__cta {
		pointer-events: none;
	}

	.event-card__img {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		background: var(--color-navy-deep);
	}

	.event-card__body {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: clamp(0.4rem, 1.2vw, 0.7rem);
		padding: clamp(1.1rem, 2.5vw, 1.6rem);
	}

	.event-card__date {
		font-size: clamp(0.72rem, 1.4vw, 0.8rem);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-blue);
	}

	.event-card__title {
		font-size: clamp(1.15rem, 2.6vw, 1.5rem);
		line-height: 1.2;
		color: var(--color-navy-deep);
	}

	.event-card__meta {
		font-size: clamp(0.82rem, 1.6vw, 0.9rem);
		color: var(--color-navy);
	}

	.event-card__desc {
		display: -webkit-box;
		-webkit-line-clamp: 7;
		-webkit-box-orient: vertical;
		overflow: hidden;
		font-size: clamp(0.9rem, 1.7vw, 1rem);
		line-height: 1.55;
		color: var(--color-navy-deep);
	}

	.event-card__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: auto;
		padding-top: 0.5rem;
	}

	.event-card__cta {
		display: inline-block;
		padding: 0.6em 1.2em;
		border: 1.5px solid var(--color-navy);
		border-radius: var(--radius);
		font-size: clamp(0.78rem, 1.4vw, 0.85rem);
		font-weight: 600;
		letter-spacing: 0.04em;
		text-decoration: none;
		text-transform: uppercase;
		color: var(--color-navy-deep);
		transition: background-color 0.15s ease;
	}

	.event-card__cta:hover {
		background: rgb(3 48 77 / 0.05);
	}

	.event-card__cta:focus-visible {
		outline: 3px solid var(--color-green);
		outline-offset: 3px;
	}
</style>
