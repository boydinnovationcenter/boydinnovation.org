---
/**
 * A section of event cards. Events more than 48 hours past are left out at
 * build time; a small script dims and removes events that pass after the
 * site was built. Register buttons with an Eventbrite id open Eventbrite's
 * checkout pop-up (falling back to the Eventbrite page without JavaScript).
 */
import type { CollectionEntry } from 'astro:content';
import { eventStatus } from '../../lib/event-dates';
import EventCard from './EventCard.astro';

interface Props {
	id: string;
	heading: string;
	events: CollectionEntry<'events'>[];
}

const { id, heading, events } = Astro.props;

const shown = events
	.map(({ data }) => ({ data, status: eventStatus(data.end ?? data.start ?? '') }))
	.filter((e): e is { data: typeof e.data; status: 'upcoming' | 'past' } => e.status !== 'hidden')
	.sort((a, b) => a.data.order - b.data.order || (a.data.start ?? '').localeCompare(b.data.start ?? ''));
---

{
	shown.length > 0 && (
		<section class="event-grid" aria-labelledby={`${id}-heading`}>
			<div class="container">
				<h2 id={`${id}-heading`}>{heading}</h2>
				<ul class="event-grid__list" role="list">
					{shown.map(({ data, status }) => (
						<EventCard event={data} status={status} />
					))}
				</ul>
			</div>
		</section>
	)
}

<script>
	import { eventStatus } from '../../lib/event-dates';

	// Dim events that ended since the build, and remove them after 48 hours.
	document.querySelectorAll<HTMLElement>('.event-card[data-ends]').forEach((card) => {
		const status = eventStatus(card.dataset.ends!);
		if (status === 'hidden') card.remove();
		else if (status === 'past') card.classList.add('event-card--past');
	});
	document.querySelectorAll<HTMLElement>('.event-grid').forEach((section) => {
		if (!section.querySelector('.event-card')) section.remove();
	});

	// Eventbrite checkout pop-ups. The widget script is heavy, so it loads only
	// if a card needs it, once the page is idle. Until then (or without
	// JavaScript) Register links open the event on Eventbrite.
	type EBWidgets = { createWidget: (options: Record<string, unknown>) => void };
	const triggers = document.querySelectorAll<HTMLAnchorElement>('a[data-eventbrite-id]');

	const loadEventbrite = () => {
		const script = document.createElement('script');
		script.src = 'https://www.eventbrite.com/static/widgets/eb_widgets.js';
		script.async = true;
		script.onload = () => {
			const eb = (window as Window & { EBWidgets?: EBWidgets }).EBWidgets;
			if (!eb) return;
			triggers.forEach((link) => {
				const eventId = link.dataset.eventbriteId!;
				link.id ||= `eventbrite-widget-modal-trigger-${eventId}`;
				link.addEventListener('click', (e) => e.preventDefault());
				link.removeAttribute('target');
				link.setAttribute('aria-haspopup', 'dialog');
				eb.createWidget({ widgetType: 'checkout', eventId, modal: true, modalTriggerElementId: link.id });
			});
		};
		document.head.append(script);
	};

	if (triggers.length) {
		const whenIdle = () =>
			'requestIdleCallback' in window ? requestIdleCallback(loadEventbrite, { timeout: 4000 }) : setTimeout(loadEventbrite, 2000);
		if (document.readyState === 'complete') whenIdle();
		else addEventListener('load', whenIdle, { once: true });
	}
</script>

<style>
	.event-grid {
		padding-block: var(--space-7);
	}

	.event-grid ~ :global(.event-grid) {
		border-top: 1px solid var(--color-navy-deep);
	}

	h2 {
		margin-bottom: var(--space-4);
	}

	.event-grid__list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
		gap: clamp(1rem, 2.5vw, 1.75rem);
		padding: 0;
		list-style: none;
	}

	/* A lone card doesn't stretch past two-column width. */
	.event-grid__list > :global(:only-child) {
		max-width: 40.5rem;
	}
</style>
