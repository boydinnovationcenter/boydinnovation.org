---
import { Image } from 'astro:assets';
import CtaButton from '../CtaButton.astro';

interface Props {
	heading: string;
	intro: string;
	image: ImageMetadata;
	/** First action is the calendar subscribe link, second the rentals link. */
	actions: { label: string; href: string }[];
}

const { heading, intro, image, actions } = Astro.props;
---

<section class="events-hero" aria-labelledby="events-title">
	<Image
		class="events-hero__bg"
		src={image}
		alt=""
		widths={[640, 1024, 1600]}
		sizes="100vw"
		loading="eager"
		fetchpriority="high"
	/>
	<div class="container events-hero__inner">
		<div class="events-hero__text">
			<h1 id="events-title">{heading}</h1>
			<p>{intro}</p>
		</div>
		<div class="events-hero__actions">
			{
				actions.map((action, i) => (
					<CtaButton variant={i === 0 ? 'primary' : 'glass'} label={action.label} href={action.href} />
				))
			}
		</div>
	</div>
</section>

<style>
	/* Live hero height (684px at 1440), with the content held near the bottom. */
	.events-hero {
		position: relative;
		isolation: isolate;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-height: clamp(30rem, 47.5vw, 46rem);
		padding-block: calc(var(--header-height) + 3.5rem) 5rem;
		overflow: hidden;
		background: var(--color-navy-deep);
		color: var(--color-text-on-dark);
	}

	/* The crowd photo as texture behind the text. */
	.events-hero__bg {
		position: absolute;
		inset: 0;
		z-index: -1;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.22;
	}

	.events-hero__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--space-5) var(--space-6);
	}

	.events-hero__text {
		flex: 1 1 32rem;
		max-width: 51rem;
		display: grid;
		gap: 1.25rem;
	}

	h1 {
		font-size: clamp(2.4rem, 1.2rem + 3.5vw, 4rem);
		font-weight: 700;
		line-height: 1.05;
	}

	.events-hero__text p {
		font-size: clamp(1.05rem, 1rem + 0.25vw, 1.25rem);
		line-height: 1.6;
	}

	.events-hero__actions {
		flex: 0 1 16.25rem;
		display: grid;
		gap: 0.625rem;
	}

	.events-hero__actions :global(.btn) {
		min-height: 3.5rem;
		border-radius: 6px;
		font-size: 0.875rem;
	}

	@media (max-width: 47.99rem) {
		.events-hero__actions {
			flex-basis: 100%;
		}
	}
</style>
