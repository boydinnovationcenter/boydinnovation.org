---
interface Props {
	network: 'instagram' | 'facebook' | 'linkedin';
}

const { network } = Astro.props;
---

<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
	{
		network === 'instagram' && (
			<g fill="none" stroke="currentColor" stroke-width="2">
				<rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
				<circle cx="12" cy="12" r="4.5" />
				<circle cx="17.6" cy="6.4" r="0.6" fill="currentColor" stroke="none" />
			</g>
		)
	}
	{
		network === 'facebook' && (
			<path
				fill="currentColor"
				d="M13.4 21.5v-8h2.7l.4-3.2h-3.1V8.3c0-.9.3-1.5 1.6-1.5h1.6V4c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.4-4 4.1v2.3H7.5v3.2h2.7v8z"
			/>
		)
	}
	{
		network === 'linkedin' && (
			<path
				fill="currentColor"
				d="M4.5 8.8h3.3v10.7H4.5zM6.2 3.5a1.9 1.9 0 1 1 0 3.8 1.9 1.9 0 0 1 0-3.8m3.7 5.3h3.2v1.5c.4-.8 1.5-1.7 3.1-1.7 3.4 0 4 2.2 4 5.1v5.9h-3.3v-5.2c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8v5.3H9.9z"
			/>
		)
	}
</svg>
