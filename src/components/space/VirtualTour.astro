---
interface Props {
	eyebrow: string;
	heading: string;
	embedUrl: string;
	title: string;
}

const { eyebrow, heading, embedUrl, title } = Astro.props;
---

<section class="tour" id="virtualtour" aria-labelledby="tour-heading">
	<div class="container">
		<p class="tour__eyebrow">{eyebrow}</p>
		<h2 id="tour-heading">{heading}</h2>
		<div class="tour__frame">
			<iframe src={embedUrl} title={title} allowfullscreen loading="lazy"></iframe>
		</div>
	</div>
</section>

<style>
	.tour {
		padding-block: var(--space-7) var(--space-8);
		background: var(--color-navy-deep);
		color: var(--color-text-on-dark);
	}

	.tour__eyebrow {
		color: var(--color-accent);
	}

	.tour__frame {
		max-width: 55rem;
		margin: var(--space-5) auto 0;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border-radius: 1.5rem;
		background: #000;
		box-shadow:
			0 20px 25px -5px rgb(0 0 0 / 0.1),
			0 8px 10px -6px rgb(0 0 0 / 0.1);
	}

	iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>
