---
/**
 * Private offices as alternating rows (details + photo, photo + details).
 * Replaces the live layout, where the cards overlapped each other.
 */
import { Image } from 'astro:assets';
import CtaButton from '../CtaButton.astro';

interface Props {
	heading: string;
	cta: { label: string; href: string };
	items: {
		name: string;
		price: string;
		availability: string;
		availabilityNote?: string | { label: string; href: string };
		features: string[];
		photo: { image: ImageMetadata; alt: string };
	}[];
}

const { heading, cta, items } = Astro.props;
---

<section class="offices" id="officerentals" aria-labelledby="offices-heading">
	<div class="container head-cta-layout">
		<h2 id="offices-heading" class="head-cta-layout__head">{heading}</h2>
		<CtaButton class="head-cta-layout__cta" variant="outline" label={cta.label} href={cta.href} />
		<ul class="offices__list head-cta-layout__body" role="list">
			{
				items.map((office) => (
					<li class="office">
						<div class="office__card">
							<p class="office__availability">
								<strong>{office.availability}</strong>
								{typeof office.availabilityNote === 'string' && <strong>{office.availabilityNote}</strong>}
								{typeof office.availabilityNote === 'object' && (
									<a href={office.availabilityNote.href}>
										{office.availabilityNote.label}
										<span class="visually-hidden"> for {office.name}</span>
									</a>
								)}
							</p>
							<h3>
								{office.name} | <span class="office__price">{office.price}</span>
							</h3>
							<ul class="chevron-list text-sm" role="list">
								{office.features.map((feature) => (
									<li>{feature}</li>
								))}
							</ul>
						</div>
						<Image
							class="office__photo"
							src={office.photo.image}
							alt={office.photo.alt}
							widths={[480, 720, 1000]}
							sizes="(min-width: 64rem) 34vw, 100vw"
						/>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.offices {
		padding-block: var(--space-7) var(--space-5);
	}

	.offices__list {
		display: grid;
		gap: var(--space-5);
		padding: 0;
		list-style: none;
	}

	/* Phones: photo above the details. */
	.office {
		display: flex;
		flex-direction: column-reverse;
		gap: 0.6rem;
	}

	.office__card {
		position: relative;
		display: grid;
		align-content: start;
		gap: var(--space-4);
		padding: var(--space-5) 1.25rem var(--space-5);
		border: 1px solid var(--color-black);
		border-radius: var(--radius);
	}

	.office__availability {
		justify-self: end;
		display: grid;
		justify-items: center;
		margin: calc(-1 * var(--space-5)) calc(-1.25rem - 1px) 0 0;
		padding: 0.45rem 0.75rem;
		border-radius: 0 var(--radius) 0 0;
		background: var(--color-blue);
		color: #fff;
		font-size: var(--text-sm);
		line-height: 1.6;
		text-align: center;
	}

	.office__availability a {
		font-weight: 700;
	}

	h3 {
		color: var(--color-text);
	}

	.office__price {
		color: var(--color-blue);
	}

	.office .chevron-list {
		gap: 0.15rem;
		font-weight: 700;
		color: var(--color-text-strong);
	}

	.office__photo {
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		border-radius: var(--radius);
	}

	@media (min-width: 48rem) {
		/* Side by side, alternating which side the photo is on. */
		.office {
			display: grid;
			grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
			align-items: stretch;
		}

		.office:nth-child(even) {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
		}

		.office:nth-child(even) .office__photo {
			order: -1;
		}

		.office__card {
			padding: var(--space-5) clamp(1.25rem, 4vw, 2.4rem);
		}

		.office__availability {
			margin-right: calc(-1 * clamp(1.25rem, 4vw, 2.4rem) - 1px);
		}

		.office__photo {
			height: 100%;
			min-height: 15rem;
		}
	}
</style>
