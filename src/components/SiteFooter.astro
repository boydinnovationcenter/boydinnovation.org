---
import { Image } from 'astro:assets';
import logo from '../assets/images/brand/logo-wide-one-color.png';
import { footerNav, site, socialLinks } from '../config/site';
import NewsletterSignup from './NewsletterSignup.astro';
import SocialIcon from './SocialIcon.astro';
---

<NewsletterSignup />

<footer class="site-footer">
	<div class="site-footer__brand">
		<Image src={logo} alt={site.name} width={323} densities={[1, 2, 3]} quality={90} />
		<address class="text-sm">
			{site.address.streetAddress}<br />
			{`${site.address.addressLocality}, ${site.address.addressRegion} ${site.address.postalCode}`}<br />
			<a href={`tel:+1${site.telephone.replaceAll('-', '')}`}>{site.telephone}</a>
		</address>
		<ul class="site-footer__social" role="list">
			{
				socialLinks.map((s) => (
					<li>
						<a href={s.href} target="_blank" rel="noopener">
							<SocialIcon network={s.network} />
							<span class="visually-hidden">
								{s.label} (opens in a new tab)
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>

	<nav class="site-footer__nav" aria-label="Footer">
		{
			footerNav.map((group) => (
				<div class="site-footer__group">
					<h2>{group.heading}</h2>
					<ul role="list">
						{group.links.map((link) => (
							<li>
								<a href={link.href} {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}>
									{link.label}
									{link.external && <span class="visually-hidden"> (opens in a new tab)</span>}
								</a>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</nav>

	<div class="site-footer__legal">
		<p>
			Boyd Innovation Center is a registered dba of GrowCo Columbia, Inc., a nonprofit organization officially
			recognized as a 501(c)(3).
		</p>
		<p>
			Your support helps us continue building opportunities for founders and our community. Contributions are
			tax-deductible to the extent permitted by law.
		</p>
	</div>
</footer>

<style>
	.site-footer {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-4);
		padding: var(--space-4) var(--gutter) var(--space-5);
		font-size: var(--text-sm);
	}

	.site-footer__brand img {
		width: min(100%, 20.2rem);
	}

	address {
		margin-top: var(--space-3);
		font-style: normal;
		color: var(--color-text-strong);
	}

	address a {
		text-decoration: none;
	}

	.site-footer__social {
		display: flex;
		gap: var(--space-2);
		margin-top: var(--space-3);
		padding: 0;
		list-style: none;
	}

	.site-footer__social a {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		color: var(--color-text);
	}

	.site-footer__social a:hover {
		opacity: 0.7;
	}

	.site-footer__nav {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), max-content));
		gap: var(--space-4) var(--space-5);
		align-content: start;
	}

	.site-footer__group h2 {
		font-size: inherit;
		font-weight: 700;
		line-height: 1.8;
	}

	.site-footer__group ul {
		padding: 0;
		list-style: none;
	}

	.site-footer__group a {
		display: inline-block;
		/* 1px padding offset by -1px margin: the tap area reaches 24px (WCAG 2.5.8) without moving anything. */
		padding-block: 1px;
		margin-block: -1px;
		line-height: 1.8;
		text-transform: uppercase;
	}

	.site-footer__legal {
		display: grid;
		gap: var(--space-5);
		padding-top: var(--space-4);
		text-align: center;
		line-height: 2;
	}

	@media (min-width: 48rem) {
		.site-footer {
			grid-template-columns: 1fr auto;
			gap: var(--space-5);
		}

		.site-footer__nav {
			grid-template-columns: repeat(3, max-content);
			gap: var(--space-4);
		}

		.site-footer__legal {
			grid-column: 1 / -1;
			gap: var(--space-4);
			line-height: 1.3;
		}
	}
</style>
